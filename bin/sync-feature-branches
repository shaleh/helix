#!/usr/bin/env bash
#
# Rebase every feature branch listed under '## <branch-name>' headings in
# changelog.daily-driver onto a fresh upstream/master, one at a time. Stops
# on the first conflict so you can resolve it by hand, then resumes from
# where it left off.
#
# This is the companion to bin/rebuild-daily-driver. That script assembles
# the daily-driver branch from the feature branches. This one keeps the
# feature branches themselves current with upstream so the assembly stays
# clean and rebasable.
#
# After each branch rebases it gets validated: clippy clean, tests pass
# including the integration suite, and a release build succeeds. A branch
# is only considered done once it both rebases and passes all of that.
#
# Default: show which branches are current and which need a rebase, then
# exit. Need --sync to actually rebase, --continue to resume after you
# resolved a conflict or fixed a failed check.

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: bin/sync-feature-branches [--sync | --continue]

  (no flag)    Show which branches are current and which need rebasing;
               do not modify anything.
  --sync       Fetch upstream/master, then rebase each branch listed in
               changelog.daily-driver onto it, in order. After each rebase,
               validate the branch: clippy, tests, integration tests, and a
               release build. Stops on the first conflict or failed check.
  --continue   Resume after a rebase conflict or a failed check. Picks up at
               the first branch not yet recorded as done. For a conflict,
               run 'git rebase --continue' first. For a failed check, fix it
               on the branch first.
EOF
}

MODE="dry-run"  # dry-run | sync | continue
for arg in "$@"; do
    case "$arg" in
        --sync)      MODE="sync" ;;
        --continue)  MODE="continue" ;;
        -h|--help)   usage; exit 0 ;;
        *) echo "unknown arg: $arg" >&2; usage >&2; exit 2 ;;
    esac
done

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"
GIT_DIR=$(git rev-parse --git-dir)

UPSTREAM="upstream/master"
RUNTIME_DIR="$HOME/.local/share/helix/runtime"

# Branches that have rebased and passed every check this run. Resume reads
# this instead of asking whether a branch contains upstream. A branch that
# rebased cleanly but failed a check already contains upstream, so going by
# ancestry alone would skip the one branch we still need to retry.
DONE_FILE="$GIT_DIR/sync-feature-branches.done"

is_done() { [[ -f "$DONE_FILE" ]] && grep -qxF "$1" "$DONE_FILE"; }
mark_done() { echo "$1" >>"$DONE_FILE"; }

# Branches listed in the changelog, in document order. The parsing lives in
# bin/daily-driver-branches so this and the rebuild script stay in agreement.
# Only our own branches get synced. Upstream contributors' branches carry a
# namespace prefix and aren't ours to rebase.
BRANCH_LIST=$("$ROOT/bin/daily-driver-branches" --mine)
BRANCHES=()
while IFS= read -r b; do
    BRANCHES+=("$b")
done <<<"$BRANCH_LIST"

# A branch is current when upstream/master is already one of its ancestors,
# meaning it carries everything in upstream. After a fetch this is only true
# for branches we have already rebased this run, which is what lets
# --continue skip past them.
is_current() {
    git merge-base --is-ancestor "$UPSTREAM" "$1" 2>/dev/null
}

# Stop the run when a branch fails a check. The branch is rebased but not
# recorded as done, so --continue comes straight back to it after a fix.
report_check_failure() {
    local branch="$1" check="$2"
    cat >&2 <<EOF

Branch '$branch' failed: $check.

The rebase landed, but '$branch' does not pass $check yet.

Next steps:
  1. Fix it on '$branch' (amend or add a commit).
  2. Resume the sync:   bin/sync-feature-branches --continue
EOF
    exit 1
}

# The integration suite aborts with SIGABRT now and then for reasons that have
# nothing to do with the branch under test. It passes on a rerun. Retry only
# that case so one flake does not halt the whole sync. A genuine test failure
# has no signal abort in its output, so it reports right away.
INTEGRATION_ATTEMPTS=3
run_integration_tests() {
    local b="$1" attempt log
    log=$(mktemp)
    for ((attempt = 1; attempt <= INTEGRATION_ATTEMPTS; attempt++)); do
        if cargo integration-test 2>&1 | tee "$log"; then
            rm -f "$log"
            return 0
        fi
        if ! grep -q "SIGABRT" "$log"; then
            break
        fi
        echo "==> $b: integration tests aborted with SIGABRT (attempt $attempt of $INTEGRATION_ATTEMPTS); retrying" >&2
    done
    rm -f "$log"
    report_check_failure "$b" "integration tests"
}

# Run the full gate on whatever branch is currently checked out. Clippy
# matches CI and fails on warnings. Integration tests run through the cargo
# alias so they pick up the integration feature and profile. A clean release
# build with the runtime path is the last gate.
validate_branch() {
    local b="$1"
    echo "==> $b: clippy"
    cargo clippy --workspace --all-targets -- -D warnings || report_check_failure "$b" "clippy"
    echo "==> $b: tests"
    cargo test --workspace || report_check_failure "$b" "tests"
    echo "==> $b: integration tests"
    run_integration_tests "$b"
    echo "==> $b: release build"
    HELIX_DEFAULT_RUNTIME="$RUNTIME_DIR" cargo build --release || report_check_failure "$b" "release build"
}

# Refuse to touch anything while a rebase is half-done. The advice differs
# by mode: on continue we want the rebase finished, otherwise aborted.
if [[ -d "$GIT_DIR/rebase-merge" || -d "$GIT_DIR/rebase-apply" ]]; then
    echo "error: a rebase is already in progress" >&2
    case "$MODE" in
        continue) echo "       resolve conflicts and 'git rebase --continue' first" >&2 ;;
        *)        echo "       finish it, or 'git rebase --abort', before syncing" >&2 ;;
    esac
    exit 1
fi

# Verify each listed branch exists locally — refuse to start otherwise.
MISSING=()
for b in "${BRANCHES[@]}"; do
    git rev-parse --verify "$b" >/dev/null 2>&1 || MISSING+=("$b")
done
if [[ ${#MISSING[@]} -gt 0 ]]; then
    echo "error: branch(es) listed in changelog but missing locally:" >&2
    for b in "${MISSING[@]}"; do echo "  - $b" >&2; done
    exit 1
fi

if ! git rev-parse --verify "$UPSTREAM" >/dev/null 2>&1; then
    if [[ "$MODE" == "dry-run" ]]; then
        echo "note: $UPSTREAM not fetched yet; --sync will fetch it first"
    else
        echo "error: $UPSTREAM not resolvable; can't sync" >&2
        exit 1
    fi
fi

if [[ "$MODE" == "dry-run" ]]; then
    echo "Plan: rebase each branch onto $UPSTREAM, in order:"
    for b in "${BRANCHES[@]}"; do
        if is_current "$b"; then
            echo "  - $b (current)"
        else
            echo "  - $b (needs rebase)"
        fi
    done
    echo
    echo "Each branch is also validated after rebase: clippy, tests,"
    echo "integration tests, and a release build."
    echo
    echo "Status is against the currently fetched $UPSTREAM. --sync fetches first."
    echo "Dry run. Pass --sync to execute."
    exit 0
fi

if [[ -n "$(git status --porcelain)" ]]; then
    echo "error: working tree not clean; commit or stash first" >&2
    exit 1
fi

# Remember where we started so we can land back here when we finish.
STARTING_BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [[ "$MODE" == "sync" ]]; then
    echo "==> fetching $UPSTREAM"
    git fetch upstream master
    # Fresh run, so forget what an earlier run had marked done.
    rm -f "$DONE_FILE"
fi

for b in "${BRANCHES[@]}"; do
    if is_done "$b"; then
        echo "==> $b already done this run, skipping"
        continue
    fi
    # A branch can already carry upstream and still be unvalidated. That is
    # exactly the resume case after a conflict was finished by hand. Skip the
    # rebase then, but still run the checks before calling it done.
    if is_current "$b"; then
        echo "==> $b already current, skipping rebase"
    else
        echo "==> rebasing $b onto $UPSTREAM"
        if ! git rebase "$UPSTREAM" "$b"; then
            cat >&2 <<EOF

Rebase of '$b' hit conflicts.

Next steps:
  1. Resolve conflicts in the listed files.
  2. Stage the fixes:       git add <files>
  3. Continue the rebase:   git rebase --continue
  4. Resume the sync:       bin/sync-feature-branches --continue

To abandon this branch's rebase and stop:
                            git rebase --abort
EOF
            exit 1
        fi
    fi
    validate_branch "$b"
    mark_done "$b"
done

# Every branch rebased and passed, so the marker has done its job.
rm -f "$DONE_FILE"

# Land back on the branch we started from. Best effort — say so if it is gone.
if git rev-parse --verify "$STARTING_BRANCH" >/dev/null 2>&1; then
    git checkout --quiet "$STARTING_BRANCH"
fi

echo "Done. All branches current with $UPSTREAM and passing checks."
